# Base URL backend API NestJS / app server.
VITE_API_URL=http://localhost:3000

# Supabase hanya untuk realtime client di frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Midtrans client key platform untuk flow checkout subscription di landing page.
VITE_MIDTRANS_PLATFORM_CLIENT_KEY=

# Public VAPID key untuk subscribe push notification di browser.
VITE_VAPID_PUBLIC_KEY=
