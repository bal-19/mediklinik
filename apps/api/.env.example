# HTTP server API
PORT=3000
NODE_ENV=development

# Dipakai sementara oleh repository Supabase selama auth tenant penuh
# belum dihubungkan ke context request.
DEFAULT_CLINIC_ID=

# Supabase project URL dan service role key.
# Service role hanya untuk backend, jangan pernah expose ke frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT untuk access token dan refresh token.
# Gunakan secret yang panjang dan berbeda.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Midtrans platform milik MediKlinik untuk subscription SaaS.
MIDTRANS_PLATFORM_SERVER_KEY=
MIDTRANS_PLATFORM_CLIENT_KEY=
MIDTRANS_PLATFORM_IS_PRODUCTION=false

# URL frontend yang diizinkan untuk CORS.
FRONTEND_URL=http://localhost:5173

# VAPID key untuk Web Push notification.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
